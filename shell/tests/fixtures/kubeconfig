# Minimal kubeconfig for the shell test harness. The server is never contacted:
# the completion is answered from the local-file cache fixture.
apiVersion: v1
kind: Config
current-context: e2e
clusters:
  - name: e2e
    cluster:
      server: https://127.0.0.1:6443
      insecure-skip-tls-verify: true
contexts:
  - name: e2e
    context:
      cluster: e2e
      user: e2e
      namespace: web
users:
  - name: e2e
    user:
      token: not-a-real-token
