apiVersion: v1
kind: Config
current-context: minikube
clusters:
- name: minikube
  cluster:
    server: https://192.168.49.2:8443
- name: prod
  cluster:
    server: https://prod.example.com
contexts:
- name: minikube
  context:
    cluster: minikube
    user: minikube
    namespace: kube-system
- name: no-namespace
  context:
    cluster: minikube
    user: minikube
- name: prod
  context:
    cluster: prod
    user: prod-token
    namespace: prod-ns
users:
- name: minikube
  user: {}
- name: prod-token
  user:
    token: a-token
- name: exec-user
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: /usr/local/bin/aws-iam-authenticator
